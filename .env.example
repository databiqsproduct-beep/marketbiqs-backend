APP_NAME=Biqs Agency Intelligence
SECRET_KEY=change-me-in-production
APP_ENV=development

DATABASE_URL=
# Required for production (Railway). Copy Transaction pooler URI from:
# Supabase → Project Settings → Database → Connect → Connection string
# Port 6543. Host is often aws-1-<region>.pooler.supabase.com (NOT always aws-0 / us-east-1).
# Wrong host → "Tenant or user not found" → login/register 500.
# Example for this project:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# Or set password + ref + host (app builds the URL):
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=wcseztlbcajqegmzpzqm
SUPABASE_DB_REGION=ap-northeast-2
SUPABASE_POOLER_HOST=aws-1-ap-northeast-2.pooler.supabase.com
# Also set on Railway: APP_ENV=production

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3001
API_BASE_URL=http://127.0.0.1:8001

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional for legacy HS256 projects. New projects often use ES256 signing keys —
# the API verifies those via SUPABASE_URL/auth/v1/.well-known/jwks.json automatically.
# Project Settings → API → JWT Secret (legacy) if still using HS256:
SUPABASE_JWT_SECRET=
# Legacy aliases still accepted:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth: frontend uses Supabase email + Google OAuth; API only verifies Bearer access tokens.
# Google: enable provider in Supabase Auth; allow-list redirect URLs:
#   http://localhost:3000/auth/callback
#   https://YOUR_FRONTEND/auth/callback
# Google Cloud OAuth client redirect must be:
#   https://YOUR_PROJECT.supabase.co/auth/v1/callback

GROQ_API_KEY=
APIFY_KEY=
SERP_API=
FIRECRAWL_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AGENCY_PRICE_ID=
STRIPE_CLIENT_PACK_PRICE_ID=

RESEND_API_KEY=
EMAIL_FROM=Biqs <reports@biqs.ai>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

SCRAPE_INTERVAL_HOURS=24
ENCRYPTION_KEY=change-me-fernet-key-32b
